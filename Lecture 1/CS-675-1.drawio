        <mxCell id="AeTiZLamMoqDxRa9LT03-49" parent="1" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;" value="BIG DATA DB" vertex="1">
          <mxGeometry height="60" width="100" x="352.68" y="1660" as="geometry" />
        </mxCell>
        <mxCell id="AeTiZLamMoqDxRa9LT03-50" parent="1" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;" value="Big Data:&lt;div&gt;&lt;br&gt;&lt;div&gt;- We have a lot of unstructured data to analyze&lt;/div&gt;&lt;div&gt;- We want to store them in the disk to reduce cost rather than storing in a database intantace&lt;/div&gt;&lt;div&gt;- We want to store data that doesn&#39;t fit in single relational database or it will is difficult/not worth it to partition or shard data in a easy, elegant way&lt;/div&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="60" width="545.25" x="115.24000000000001" y="1390" as="geometry" />
        </mxCell>
        <mxCell id="AeTiZLamMoqDxRa9LT03-51" parent="1" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;" value="&lt;div&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;OLTP: Online Transaction Processing&lt;/span&gt;&lt;/div&gt;&lt;div&gt;OLAP: Online Analytical Processing&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;RDBMSs are catered toward&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&amp;nbsp;OLTP.&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;Big Data systems are&amp;nbsp;&lt;i&gt;mostly&lt;/i&gt; catered toward&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;OLAP solution.&lt;/span&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="100" width="556" x="115.24000000000001" y="1220" as="geometry" />
        </mxCell>
