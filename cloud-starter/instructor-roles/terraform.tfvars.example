# Copy to terraform.tfvars and set your own roster. Use one lowercase id per
# student (letters, digits, hyphens); these become the S3 bucket prefixes.
region          = "us-east-2"
resource_prefix = "ds"

students = [
  "student01", "student02", "student03", "student04",
  "student05", "student06",
  # ... one entry per student
]

# Optional: ARNs allowed to assume the per-student roles (e.g. each student's IAM
# user). If omitted, defaults to the account root and you grant assume separately.
# assume_role_principal_arns = []
