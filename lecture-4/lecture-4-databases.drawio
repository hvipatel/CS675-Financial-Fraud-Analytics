<mxfile host="app.diagrams.net" version="22.0.0">
  <diagram name="Databases-Partitioning" id="lecture-4-databases">
    <mxGraphModel dx="1200" dy="3200" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="2700" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="Lecture 4 — NoSQL Databases and Partitioning: KV, Cache-Aside, Sharding, Documents" style="text;html=1;align=center;verticalAlign=middle;fontSize=18;fontStyle=1;fillColor=#dae8fc;strokeColor=#6c8ebf;rounded=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="1120" height="50" as="geometry" />
        </mxCell>

        <mxCell id="dataset_hdr" value="Running example data (same employees as the file-formats diagram)" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontStyle=2;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="40" y="84" width="1120" height="22" as="geometry" />
        </mxCell>
        <mxCell id="dataset_body" value="id=1 Alice (Developer, active)   ·   id=2 Bob (Designer, inactive)   ·   id=3 Charlie (Manager, active)   ·   id=4 Dana (Developer, inactive)   ·   id=5 Eve (Designer, active)" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontFamily=Courier New;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="40" y="106" width="1120" height="26" as="geometry" />
        </mxCell>

        <mxCell id="s1_header" value="1.  Key-Value Model — Redis" style="text;html=1;align=left;verticalAlign=middle;fontSize=15;fontStyle=1;fillColor=#e1d5e7;strokeColor=#9673a6;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="40" y="160" width="1120" height="34" as="geometry" />
        </mxCell>
        <mxCell id="s1_intro" value="One key → one opaque value (a JSON document). Lookups by key are O(1). The store does not index into the value." style="text;html=1;align=left;verticalAlign=middle;fontSize=12;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="40" y="200" width="1120" height="24" as="geometry" />
        </mxCell>

        <mxCell id="kv_k_hdr" value="Key" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontStyle=1;align=center;" vertex="1" parent="1">
          <mxGeometry x="40" y="234" width="80" height="28" as="geometry" />
        </mxCell>
        <mxCell id="kv_v_hdr" value="Value (JSON document)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontStyle=1;align=center;" vertex="1" parent="1">
          <mxGeometry x="120" y="234" width="640" height="28" as="geometry" />
        </mxCell>

        <mxCell id="kv_k1" value="&quot;1&quot;" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Courier New;align=center;" vertex="1" parent="1">
          <mxGeometry x="40" y="262" width="80" height="44" as="geometry" />
        </mxCell>
        <mxCell id="kv_v1" value="{ &quot;id&quot;: 1, &quot;name&quot;: &quot;Alice&quot;,   &quot;role&quot;: &quot;Developer&quot;, &quot;active&quot;: true  }" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Courier New;align=left;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry x="120" y="262" width="640" height="44" as="geometry" />
        </mxCell>

        <mxCell id="kv_k2" value="&quot;2&quot;" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Courier New;align=center;" vertex="1" parent="1">
          <mxGeometry x="40" y="306" width="80" height="44" as="geometry" />
        </mxCell>
        <mxCell id="kv_v2" value="{ &quot;id&quot;: 2, &quot;name&quot;: &quot;Bob&quot;,     &quot;role&quot;: &quot;Designer&quot;,  &quot;active&quot;: false }" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Courier New;align=left;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry x="120" y="306" width="640" height="44" as="geometry" />
        </mxCell>

        <mxCell id="kv_k3" value="&quot;3&quot;" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Courier New;align=center;" vertex="1" parent="1">
          <mxGeometry x="40" y="350" width="80" height="44" as="geometry" />
        </mxCell>
        <mxCell id="kv_v3" value="{ &quot;id&quot;: 3, &quot;name&quot;: &quot;Charlie&quot;, &quot;role&quot;: &quot;Manager&quot;,   &quot;active&quot;: true  }" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Courier New;align=left;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry x="120" y="350" width="640" height="44" as="geometry" />
        </mxCell>

        <mxCell id="kv_note" value="Example use: a session store (key = session-id, value = user blob), or a product cache (key = product-id, value = page-render JSON)." style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontStyle=2;whiteSpace=wrap;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="780" y="262" width="380" height="132" as="geometry" />
        </mxCell>

        <mxCell id="s2_header" value="2.  Cache-Aside Pattern — where Key-Value sits in production" style="text;html=1;align=left;verticalAlign=middle;fontSize=15;fontStyle=1;fillColor=#e1d5e7;strokeColor=#9673a6;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="40" y="430" width="1120" height="34" as="geometry" />
        </mxCell>
        <mxCell id="s2_intro" value="The KV store is rarely the system of record. It sits IN FRONT of one. App reads the cache first; on miss, reads the DB(s), assembles the answer, writes it back to the cache." style="text;html=1;align=left;verticalAlign=middle;fontSize=12;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="40" y="470" width="1120" height="34" as="geometry" />
        </mxCell>

        <mxCell id="app_user" value="App User&#xa;requests &quot;Report for May 2026&quot;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="80" y="540" width="180" height="60" as="geometry" />
        </mxCell>
        <mxCell id="cache" value="Key-Value Cache&#xa;(Redis)" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="400" y="540" width="140" height="80" as="geometry" />
        </mxCell>
        <mxCell id="db_users" value="DB Users" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="700" y="520" width="120" height="60" as="geometry" />
        </mxCell>
        <mxCell id="db_orgs" value="DB Orgs" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="700" y="600" width="120" height="60" as="geometry" />
        </mxCell>
        <mxCell id="e_app_cache" value="1. check cache" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;fontSize=11;" edge="1" parent="1" source="app_user" target="cache">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_cache_dbu" value="2. on miss, read DBs" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.3;entryX=0;entryY=0.5;dashed=1;fontSize=11;" edge="1" parent="1" source="cache" target="db_users">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_cache_dbo" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.7;entryX=0;entryY=0.5;dashed=1;" edge="1" parent="1" source="cache" target="db_orgs">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="cache_note" value="3. assemble result, write to cache, return to App.&#xa;Next request for the same report = cache hit." style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontStyle=2;whiteSpace=wrap;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="880" y="540" width="280" height="80" as="geometry" />
        </mxCell>

        <mxCell id="s3_header" value="3.  Data Partitioning — DynamoDB / MongoDB sharding" style="text;html=1;align=left;verticalAlign=middle;fontSize=15;fontStyle=1;fillColor=#e1d5e7;strokeColor=#9673a6;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="40" y="700" width="1120" height="34" as="geometry" />
        </mxCell>
        <mxCell id="s3_intro" value="The partition KEY decides which physical shard each record lands on. Choice is QUERY-DRIVEN — there is no universally right partition key." style="text;html=1;align=left;verticalAlign=middle;fontSize=12;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="40" y="740" width="1120" height="24" as="geometry" />
        </mxCell>
        <mxCell id="driving_q" value="Driving query: &quot;How many ACTIVE DEVELOPERS are there?&quot;   →   answer is 1 (Alice). The three strategies below differ in how cheaply they answer this. Each shard shows the ACTUAL MongoDB documents that would live there." style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;fillColor=#fff2cc;strokeColor=#d6b656;whiteSpace=wrap;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="40" y="770" width="1120" height="44" as="geometry" />
        </mxCell>

        <mxCell id="s3a_label" value="3a.  Partition by Role  (single attribute)" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="830" width="1120" height="26" as="geometry" />
        </mxCell>

        <mxCell id="r_dev" value="Shard: Developer  (2 docs)" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="862" width="360" height="60" as="geometry" />
        </mxCell>
        <mxCell id="r_dev_d1" value="{ &quot;id&quot;: 1,&#xa;  &quot;name&quot;: &quot;Alice&quot;, &quot;role&quot;: &quot;Developer&quot;,&#xa;  &quot;active&quot;: true }" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Courier New;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=11;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="40" y="930" width="360" height="60" as="geometry" />
        </mxCell>
        <mxCell id="r_dev_d2" value="{ &quot;id&quot;: 4,&#xa;  &quot;name&quot;: &quot;Dana&quot;, &quot;role&quot;: &quot;Developer&quot;,&#xa;  &quot;active&quot;: false }" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Courier New;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=11;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="40" y="996" width="360" height="60" as="geometry" />
        </mxCell>

        <mxCell id="r_des" value="Shard: Designer  (2 docs)" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;fontStyle=1;" vertex="1" parent="1">
