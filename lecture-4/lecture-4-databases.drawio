        <mxCell id="c_mi" value="Manager × Inactive  (empty)" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#f5f5f5;strokeColor=#999999;fontSize=11;dashed=1;fontColor=#999999;fontStyle=1;" vertex="1" parent="1">
