        <mxCell id="r_des_d2" value="{ &quot;id&quot;: 5,&#xa;  &quot;name&quot;: &quot;Eve&quot;, &quot;role&quot;: &quot;Designer&quot;,&#xa;  &quot;active&quot;: true }" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Courier New;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=11;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="420" y="996" width="360" height="60" as="geometry" />
        </mxCell>

        <mxCell id="r_mgr" value="Shard: Manager  (1 doc)" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="800" y="862" width="360" height="60" as="geometry" />
        </mxCell>
        <mxCell id="r_mgr_d1" value="{ &quot;id&quot;: 3,&#xa;  &quot;name&quot;: &quot;Charlie&quot;, &quot;role&quot;: &quot;Manager&quot;,&#xa;  &quot;active&quot;: true }" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Courier New;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=11;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="800" y="930" width="360" height="60" as="geometry" />
        </mxCell>

        <mxCell id="r_note" value="Driving query: read the Developer shard (2 docs), filter active = true. Touches 1 shard but still scans 2 docs to find the 1 answer." style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontStyle=2;whiteSpace=wrap;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="40" y="1070" width="1120" height="26" as="geometry" />
        </mxCell>

        <mxCell id="s3b_label" value="3b.  Partition by Active Status  (different single attribute)" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontStyle=1;" vertex="1" parent="1">
