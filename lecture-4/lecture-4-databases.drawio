          <mxGeometry x="800" y="1658" width="360" height="60" as="geometry" />
        </mxCell>

        <mxCell id="c_note" value="Driving query: read EXACTLY ONE shard (Developer × Active). 1 doc, no filter needed. Best for THIS query.&#xa;Trade-off: a query that filters on Active alone (e.g. &quot;all active users&quot;) now touches 3 shards. Composite keys are great for the queries they index, worse for queries they don't." style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontStyle=2;whiteSpace=wrap;fontColor=#666666;spacingTop=6;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="40" y="1740" width="1120" height="50" as="geometry" />
        </mxCell>

        <mxCell id="s4_header" value="4.  Document Stores — MongoDB with embedded sub-documents" style="text;html=1;align=left;verticalAlign=middle;fontSize=15;fontStyle=1;fillColor=#e1d5e7;strokeColor=#9673a6;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="40" y="1820" width="1120" height="34" as="geometry" />
        </mxCell>
        <mxCell id="s4_intro" value="Unlike Redis, MongoDB INDEXES INTO the value. A collection holds many documents; each document is a JSON-shaped record; nested sub-documents replace what would be a JOIN in SQL." style="text;html=1;align=left;verticalAlign=middle;fontSize=12;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="40" y="1860" width="1120" height="34" as="geometry" />
        </mxCell>

        <mxCell id="coll_label" value="Collection: employees  (richer documents with embedded address sub-document)" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontStyle=1;fillColor=#fff2cc;strokeColor=#d6b656;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="40" y="1910" width="1120" height="28" as="geometry" />
        </mxCell>

        <mxCell id="doc1" value="{&#xa;  &quot;id&quot;: 1,&#xa;  &quot;name&quot;: &quot;Alice&quot;,&#xa;  &quot;role&quot;: &quot;Developer&quot;,&#xa;  &quot;active&quot;: true,&#xa;  &quot;joined_date&quot;: &quot;2026-05-12&quot;,&#xa;  &quot;address&quot;: {&#xa;    &quot;street&quot;: &quot;123 Main St.&quot;,&#xa;    &quot;city&quot;: &quot;Newark&quot;,&#xa;    &quot;zip&quot;: &quot;07101&quot;&#xa;  }&#xa;}" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Courier New;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;fontSize=11;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="40" y="1946" width="360" height="200" as="geometry" />
        </mxCell>
        <mxCell id="doc2" value="{&#xa;  &quot;id&quot;: 2,&#xa;  &quot;name&quot;: &quot;Bob&quot;,&#xa;  &quot;role&quot;: &quot;Designer&quot;,&#xa;  &quot;active&quot;: false,&#xa;  &quot;joined_date&quot;: &quot;2024-11-03&quot;,&#xa;  &quot;address&quot;: {&#xa;    &quot;street&quot;: &quot;45 Oak Ave.&quot;,&#xa;    &quot;city&quot;: &quot;Jersey City&quot;,&#xa;    &quot;zip&quot;: &quot;07302&quot;&#xa;  }&#xa;}" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Courier New;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;fontSize=11;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="420" y="1946" width="360" height="200" as="geometry" />
        </mxCell>
        <mxCell id="doc3" value="{&#xa;  &quot;id&quot;: 3,&#xa;  &quot;name&quot;: &quot;Charlie&quot;,&#xa;  &quot;role&quot;: &quot;Manager&quot;,&#xa;  &quot;active&quot;: true,&#xa;  &quot;joined_date&quot;: &quot;2026-05-20&quot;,&#xa;  &quot;address&quot;: {&#xa;    &quot;street&quot;: &quot;7 Pine Rd.&quot;,&#xa;    &quot;city&quot;: &quot;Hoboken&quot;,&#xa;    &quot;zip&quot;: &quot;07030&quot;&#xa;  }&#xa;}" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Courier New;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;fontSize=11;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="800" y="1946" width="360" height="200" as="geometry" />
        </mxCell>

        <mxCell id="doc_note" value="Each document has its own EMBEDDED address sub-document — no JOIN to a separate addresses table." style="text;html=1;align=center;verticalAlign=middle;fontSize=11;fontStyle=2;fontColor=#666666;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="40" y="2156" width="1120" height="20" as="geometry" />
        </mxCell>

        <mxCell id="query_label" value="Sample query and compound index" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontStyle=1;fillColor=#fff2cc;strokeColor=#d6b656;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="40" y="2196" width="1120" height="28" as="geometry" />
        </mxCell>
        <mxCell id="query_text" value="QUERY:    db.employees.find({ joined_date: { $gte: &quot;2026-05-01&quot; }, active: true })&#xa;            // &quot;all active users who joined in or after May 2026&quot;  →  Alice, Charlie&#xa;&#xa;INDEX:    db.employees.createIndex({ joined_date: 1, active: 1 })&#xa;            // compound index on (joined_date, active) — makes the query O(log n) instead of full collection scan" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Courier New;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;fontSize=11;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="40" y="2232" width="1120" height="120" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
