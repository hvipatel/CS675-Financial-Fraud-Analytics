        </mxCell>
        <mxCell id="a_inact_d2" value="{ &quot;id&quot;: 4, &quot;name&quot;: &quot;Dana&quot;, &quot;role&quot;: &quot;Developer&quot;, &quot;active&quot;: false }" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Courier New;align=left;spacingLeft=10;fontSize=11;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="620" y="1264" width="540" height="40" as="geometry" />
        </mxCell>

        <mxCell id="a_note" value="Driving query: read the Active shard (3 docs), filter role = Developer. Touches 1 shard but scans 3 docs. Worse than 3a for THIS query." style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontStyle=2;whiteSpace=wrap;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="40" y="1360" width="1120" height="26" as="geometry" />
