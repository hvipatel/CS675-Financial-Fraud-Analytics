        <mxCell id="r_des_d1" value="{ &quot;id&quot;: 2,&#xa;  &quot;name&quot;: &quot;Bob&quot;, &quot;role&quot;: &quot;Designer&quot;,&#xa;  &quot;active&quot;: false }" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Courier New;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=11;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1">
